{
  "name": "vaayana",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc -b",
    "prebuild": "node scripts/copy-notices.mjs",
    "build": "tsc -b && vite build",
